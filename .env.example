# ─────────────────────────────────────────────────────────────────────────────
# Mandate Kernel — configuration
#
# Copy to `.env`. Every value below has a safe default in kernel/config.py, so
# the demo runs with an empty file. `.env` is gitignored; `.env.example` is not.
# ─────────────────────────────────────────────────────────────────────────────

# --- storage -----------------------------------------------------------------
# SQLite path. ":memory:" is fine for tests but loses the ledger on exit, which
# defeats the point of a ledger — use a file for anything you want to audit.
KERNEL_DB_PATH=kernel.db

# --- provider ----------------------------------------------------------------
# mock | rest
#   mock : in-process fake Razorpay. Deterministic, scriptable failures, no network.
#   rest : real Razorpay REST calls against TEST keys.
RAZORPAY_MODE=mock

# TEST keys only (rzp_test_...). The kernel refuses to start in `rest` mode with
# a key that does not begin with rzp_test_ unless RAZORPAY_ALLOW_LIVE=1, because
# a live key in a hackathon repo is a incident waiting to happen.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ALLOW_LIVE=0

# Webhook signature secret (HMAC-SHA256). Set it, or webhook handling is disabled
# rather than trusting unauthenticated callbacks.
RAZORPAY_WEBHOOK_SECRET=

# --- policy knobs ------------------------------------------------------------
# Accepted clock skew for signed timestamps, in seconds. Larger = friendlier to
# bad clocks, and a wider replay window.
KERNEL_CLOCK_SKEW_S=30

# How long a spent nonce is remembered. Must exceed the longest mandate TTL you
# intend to issue, or a mandate can outlive the memory of its own replay.
KERNEL_NONCE_TTL_S=86400

# Circuit breaker: consecutive denials before a mandate is frozen, and for how long.
KERNEL_BREAKER_THRESHOLD=5
KERNEL_BREAKER_COOLDOWN_S=300

# Global ceiling across all mandates. Backstop against a bug in per-mandate limits.
KERNEL_GLOBAL_RPM=120

# Capability token lifetime. Short on purpose: it is a bearer credential for one
# specific payment, and it only has to survive one provider call.
KERNEL_CAPABILITY_TTL_S=90

# Attempts (including retries) allowed per cart before the stop rule fires.
KERNEL_MAX_ATTEMPTS=3

# Provider HTTP timeout. A timeout is an UNKNOWN state, not a failure.
KERNEL_PROVIDER_TIMEOUT_S=8.0

# Start frozen. Refunds still work when this is on; nothing else does.
KERNEL_KILL_SWITCH=0

# --- planner (LLM) -----------------------------------------------------------
# deterministic | anthropic | openai
# The LLM is never on the decision path. It proposes a shopping list; the kernel
# decides. `deterministic` is the default so the repo runs with no API key.
MODEL_PROVIDER=deterministic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=claude-sonnet-4-5
MODEL_TEMPERATURE=0

# --- identities --------------------------------------------------------------
# Ed25519 keys are derived deterministically from this seed so demos reproduce
# byte for byte. In production the user key lives in a phone secure element and
# never exists on a server.
KEY_SEED=mandate-kernel-demo-seed
